# Joyus AI MCP Server Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# SERVER CONFIG
# =============================================================================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joyus_ai_mcp

# =============================================================================
# SECURITY
# =============================================================================
# Token encryption key (generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key-here

# =============================================================================
# LOCAL DEVELOPMENT AUTH BYPASS
# =============================================================================
# Set ENABLE_DEV_AUTH_BYPASS=true only for local manual testing when you do not
# want to configure Google OAuth. This bypass is ignored when NODE_ENV=production.
ENABLE_DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=local-dev@example.test
DEV_AUTH_NAME="Local Developer"

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Create at: https://console.cloud.google.com/apis/credentials
# Local redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# =============================================================================
# ATLASSIAN / JIRA OAUTH
# =============================================================================
# Create at: https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=xxx
ATLASSIAN_CLIENT_SECRET=xxx

# =============================================================================
# SLACK OAUTH
# =============================================================================
# Create at: https://api.slack.com/apps
SLACK_CLIENT_ID=xxx
SLACK_CLIENT_SECRET=xxx

# =============================================================================
# GITHUB OAUTH
# =============================================================================
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx

# =============================================================================
# AI GENERATION PROVIDER (OPTIONAL)
# =============================================================================
# When ANTHROPIC_API_KEY is set, content generation uses Anthropic.
# Leave blank to use the placeholder provider for local development.
ANTHROPIC_API_KEY=
JOYUS_ANTHROPIC_MODEL=claude-sonnet-4-6
